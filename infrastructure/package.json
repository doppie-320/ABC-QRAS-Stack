{
  "name": "infrastructure",
  "version": "0.1.0",
  "bin": {
    "infrastructure": "bin/infrastructure.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "diff:dev": "cdk diff --app \"npx ts-node --prefer-ts-exts bin/dev.ts\"",
    "diff:prod": "cdk diff --app \"npx ts-node --prefer-ts-exts bin/prod.ts\"",
    "deploy:dev": "cdk deploy --app \"npx ts-node --prefer-ts-exts bin/dev.ts\"",
    "deploy:prod": "cdk deploy --app \"npx ts-node --prefer-ts-exts bin/prod.ts\"",
    "destroy:dev": "cdk destroy --app \"npx ts-node --prefer-ts-exts bin/dev.ts\"",
    "destroy:prod": "cdk destroy --app \"npx ts-node --prefer-ts-exts bin/prod.ts\""
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "@types/qrcode": "^1.5.5",
    "aws-cdk": "2.1020.2",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.840.0",
    "@aws-sdk/client-s3": "^3.848.0",
    "@aws-sdk/util-dynamodb": "^3.840.0",
    "@types/jsonwebtoken": "^9.0.10",
    "aws-cdk-lib": "2.202.0",
    "bcryptjs": "^3.0.2",
    "constructs": "^10.0.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0"
  }
}